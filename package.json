{
	"name": "nsis",
	"displayName": "NSIS",
	"description": "Language intelligence for Nullsoft Scriptable Install System (NSIS), powered by nsis-lsp",
	"version": "6.0.0-pre.0",
	"publisher": "idleberg",
	"license": "MIT",
	"author": {
		"name": "Jan T. Sott",
		"url": "http://github.com/idleberg"
	},
	"nsisLspVersion": "0.5.5",
	"scripts": {
		"build": "tsdown && node scripts/check-bundle.mts",
		"compile": "npm run build",
		"dev": "npm run start",
		"fetch:server": "node scripts/fetch-server.mts",
		"lint": "biome check",
		"package": "vsce package --no-dependencies",
		"publish:ovsx": "ovsx publish --no-dependencies",
		"publish:vsce": "vsce publish --githubBranch main --no-dependencies",
		"start": "npm run build -- --watch",
		"test": "echo \"no tests yet\" && exit 0",
		"vscode:prepublish": "npm run build"
	},
	"keywords": [
		"nsis",
		"lsp",
		"language-server"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/vscode-nsis.git"
	},
	"homepage": "https://github.com/idleberg/vscode-nsis#readme",
	"bugs": {
		"url": "https://github.com/idleberg/vscode-nsis/issues"
	},
	"sponsor": {
		"url": "https://buymeacoffee.com/idleberg"
	},
	"type": "module",
	"main": "./lib/index.mjs",
	"icon": "resources/logo.png",
	"galleryBanner": {
		"color": "#9e90aa",
		"theme": "dark"
	},
	"dependencies": {
		"@nsis/nlf": "^0.14.2",
		"makensis": "3.0.6",
		"vscode-languageclient": "^10.1.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.4.1",
		"@types/vscode": "1.100.0",
		"@vscode/vsce": "^3.6.0",
		"ovsx": "^1.1.1",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3"
	},
	"activationEvents": [],
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Programming Languages",
		"Formatters",
		"Linters",
		"Snippets"
	],
	"contributes": {
		"configurationDefaults": {
			"[nsis]": {
				"files.encoding": "utf8bom"
			}
		},
		"languages": [
			{
				"id": "makensis",
				"aliases": [
					"MakeNSIS Log"
				]
			},
			{
				"id": "nsis",
				"aliases": [
					"NSIS",
					"nsis"
				],
				"extensions": [
					".nsi",
					".nsh",
					".bnsi",
					".bnsh"
				],
				"firstLine": "^#!/.*\\bmakensis\\b",
				"configuration": "./config/nsis.json"
			},
			{
				"id": "nlf",
				"aliases": [
					"NSIS Language File",
					"nlf"
				],
				"extensions": [
					".nlf"
				],
				"configuration": "./config/nlf.json"
			},
			{
				"id": "nsis-injection"
			}
		],
		"grammars": [
			{
				"language": "makensis",
				"scopeName": "source.makensis",
				"path": "./syntaxes/makensis.tmLanguage"
			},
			{
				"language": "nsis",
				"scopeName": "source.nsis",
				"path": "./syntaxes/nsis.tmLanguage"
			},
			{
				"language": "nlf",
				"scopeName": "source.nlf",
				"path": "./syntaxes/nlf.tmLanguage"
			},
			{
				"language": "nsis-injection",
				"scopeName": "markdown.nsis.codeblock",
				"path": "./syntaxes/codeblock.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.nsis": "nsis"
				}
			}
		],
		"snippets": [
			{
				"language": "ini",
				"path": "./snippets/core.InstallOptions.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.DrunkenNSIS.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.InstallOptions.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.NSIS.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.Options.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.Predefines.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/core.Variables.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/editor.actions.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.DrunkenNSIS.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.FileFunc.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.LogicLib.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.Memento.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.ModernUI.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.MultiUser.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.Sections.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.StrFunc.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.TextFunc.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.WinMessages.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.WinVer.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.WordFunc.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/header.x64.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.AdvSplash.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.Banner.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.BgImage.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.Dialer.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.InstallOptions.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.LangDLL.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.Math.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.nsDialogs.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.nsExec.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.NSISdl.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.Splash.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.StartMenu.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.System.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.UserInfo.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/plugin.VPatch.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/scaffold.Basic.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/scaffold.InstallOptions.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/scaffold.Minimal.json"
			},
			{
				"language": "nsis",
				"path": "./snippets/scaffold.ModernUI.json"
			}
		],
		"commands": [
			{
				"command": "nsis.compile",
				"category": "NSIS",
				"title": "Save & Compile Script",
				"icon": "$(run)"
			},
			{
				"command": "nsis.compileStrict",
				"category": "NSIS",
				"title": "Save & Compile Script (strict)",
				"icon": "$(run-all)"
			},
			{
				"command": "nsis.createBuildTask",
				"category": "NSIS",
				"title": "Create Build Task",
				"icon": "$(checklist)"
			},
			{
				"command": "nsis.openSettings",
				"category": "NSIS",
				"title": "Open Settings",
				"icon": "$(settings)"
			},
			{
				"command": "nsis.convertLanguageFile",
				"category": "NSIS",
				"title": "Convert Language File"
			},
			{
				"command": "nsis.showCompilerVersion",
				"category": "NSIS",
				"title": "Show Compiler Version"
			},
			{
				"command": "nsis.showCompilerFlags",
				"category": "NSIS",
				"title": "Show Compiler Flags"
			},
			{
				"command": "nsis.restartServer",
				"category": "NSIS",
				"title": "Restart Language Server"
			},
			{
				"command": "nsis.showOutput",
				"category": "NSIS",
				"title": "Show Language Server Output"
			},
			{
				"command": "nsis.showServerVersion",
				"category": "NSIS",
				"title": "Show Language Server Version"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"when": "resourceLangId == nlf || resourceLangId == json || resourceLangId == jsonc || resourceLangId == json5",
					"command": "nsis.convertLanguageFile"
				}
			],
			"editor/title": [
				{
					"when": "resourceLangId == nsis",
					"command": "nsis.compile",
					"group": "navigation@1"
				},
				{
					"when": "resourceLangId == nsis",
					"command": "nsis.compileStrict",
					"group": "navigation@2"
				},
				{
					"when": "resourceLangId == nsis",
					"command": "nsis.createBuildTask",
					"group": "navigation@3"
				},
				{
					"when": "resourceLangId == nsis",
					"command": "nsis.openSettings",
					"group": "navigation@4"
				}
			]
		},
		"keybindings": [
			{
				"key": "ctrl+shift+b",
				"mac": "cmd+alt+b",
				"when": "editorFocus && editorLangId == nsis",
				"command": "nsis.compile"
			},
			{
				"key": "ctrl+alt+shift+b",
				"mac": "cmd+alt+shift+b",
				"when": "editorFocus && editorLangId == nsis",
				"command": "nsis.compileStrict"
			},
			{
				"key": "alt+enter",
				"when": "editorFocus && editorLangId == nsis",
				"command": "editor.action.insertSnippet",
				"args": {
					"langid": "nsis",
					"name": "continued line"
				}
			}
		],
		"configuration": {
			"type": "object",
			"title": "NSIS LSP",
			"properties": {
				"nsis.serverPath": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the `nsis-lsp` binary. When empty, the bundled binary is used, falling back to a binary found in your `PATH`.",
					"order": 1
				},
				"nsis.makensis.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the `makensis` binary used for compilation and diagnostics. When empty, your `PATH` is searched. When compiling through Wine, set this to the path of `makensis.exe` inside your prefix.",
					"order": 2
				},
				"nsis.compiler.verbosity": {
					"type": "string",
					"enum": [
						"(default)",
						"0",
						"1",
						"2",
						"3",
						"4"
					],
					"enumDescriptions": [
						"Leaves the choice to makensis",
						"none",
						"no warnings",
						"no info",
						"no script",
						"all"
					],
					"default": "3",
					"markdownDescription": "How much the compiler reports while building.",
					"order": 3
				},
				"nsis.compiler.strictMode": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Treat compiler warnings as errors, as though every build used **Save & Compile Script (strict)**.",
					"order": 4
				},
				"nsis.compiler.customArguments": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "Additional arguments passed to `makensis`, for example `-DVERSION=1.0.0`.",
					"order": 5
				},
				"nsis.compiler.processHeaders": {
					"type": "string",
					"enum": [
						"Allow",
						"Disallow",
						"Disallow & Never Ask Me"
					],
					"enumDescriptions": [
						"Compilation is enabled for both, .nsi and .nsh files",
						"Compilation is enabled for .nsi files only, asks before compiling a header file",
						"Compilation is enabled for .nsi files only, no additional prompts are displayed"
					],
					"default": "Disallow",
					"markdownDescription": "Whether header files can be compiled directly.",
					"order": 6
				},
				"nsis.compiler.showNotifications": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Show a notification indicating whether a build succeeded or failed.",
					"order": 7
				},
				"nsis.compiler.showOutputView": {
					"type": "string",
					"enum": [
						"Always",
						"On Warnings & Errors",
						"On Errors",
						"Never"
					],
					"enumDescriptions": [
						"The output panel is shown whenever a script is compiled",
						"The output panel is only shown when the compiled script has warnings or errors",
						"The output panel is only shown when the compiled script has errors",
						"The output panel is never shown"
					],
					"default": "On Errors",
					"markdownDescription": "When to reveal the **NSIS Compiler** output panel.",
					"order": 8
				},
				"nsis.compiler.showFlagsAsObject": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Format the output of **Show Compiler Flags** as JSON rather than as the compiler's raw output.",
					"order": 9
				},
				"nsis.compiler.showVersionAsInfoMessage": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Report **Show Compiler Version** as a notification rather than in the **NSIS Info** output panel.",
					"order": 10
				},
				"nsis.buildTask.openAfterCreation": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Open `tasks.json` after **Create Build Task** has written it.",
					"order": 11
				},
				"nsis.wine.runWithWine": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Run `makensis` through [Wine](https://www.winehq.org/). Ignored on Windows.",
					"order": 12
				},
				"nsis.wine.pathToWine": {
					"type": "string",
					"default": "wine",
					"markdownDescription": "Path to the `wine` binary. When empty, your `PATH` is searched.",
					"order": 13
				},
				"nsis.diagnostics.enabledOnSave": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Run `makensis` diagnostics when a script is saved.",
					"order": 14
				},
				"nsis.diagnostics.preprocessMode": {
					"type": "string",
					"enum": [
						"ppo",
						"safe_ppo",
						"none"
					],
					"enumDescriptions": [
						"Preprocess only, skips code generation",
						"Preprocess only, skips code generation and macro expansion",
						"Runs a full compilation"
					],
					"default": "ppo",
					"markdownDescription": "Preprocessor mode used for compiler diagnostics.",
					"order": 15
				},
				"nsis.formatter.endOfLine": {
					"type": "string",
					"enum": [
						"(auto)",
						"lf",
						"crlf"
					],
					"enumDescriptions": [
						"Uses the operating system's default end of line sequence",
						"line-feed (LF)",
						"carriage return + line-feed (CRLF)"
					],
					"default": "(auto)",
					"markdownDescription": "End of line sequence used by the formatter.",
					"order": 16
				},
				"nsis.formatter.commentStyle": {
					"type": "string",
					"enum": [
						"(preserve)",
						"hash",
						"semi"
					],
					"enumDescriptions": [
						"Leaves line comments as they are",
						"Rewrites `; comment` as `# comment`",
						"Rewrites `# comment` as `; comment`"
					],
					"default": "(preserve)",
					"markdownDescription": "Line comment style the formatter normalises to. Block comments are never rewritten.",
					"order": 17
				},
				"nsis.formatter.printWidth": {
					"type": "number",
					"default": 0,
					"markdownDescription": "Maximum line width before breaking lines with `\\` continuations. Set to `0` to disable wrapping.",
					"order": 18
				},
				"nsis.formatter.singleQuote": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Prefer single quotes over double quotes.",
					"order": 19
				},
				"nsis.formatter.trimEmptyLines": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Collapse consecutive empty lines.",
					"order": 20
				},
				"nsis.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"markdownDescription": "Traces the communication between VS Code and the language server.",
					"order": 21
				}
			}
		}
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
